{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "nub run typecheck && nub run lint && nub run format:check && nub run test:unit && nub run test:e2e",
    "clean": "rm -rf .tanstack .wrangler coverage dist node_modules/.vite playwright-report test-results",
    "deploy": "nub run build && wrangler deploy",
    "deploy:preview": "nub run build && wrangler versions upload",
    "dev": "vite dev --port 3000",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "preview": "vite preview --port 4173",
    "resume:pdf": "nub scripts/generate-resume-pdf.ts",
    "test": "nub run test:unit && nub run test:e2e",
    "test:e2e": "nub run build && nubx playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.52.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "nub@0.7.5",
  "allowBuilds": {
    "esbuild": true,
    "lightningcss": true,
    "sharp": true,
    "workerd": true
  }
}
